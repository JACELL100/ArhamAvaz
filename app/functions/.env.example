# Copy to functions/.env (git-ignored) and fill in. Firebase deploys this file with the functions.

# Razorpay — Dashboard → Account & Settings → API Keys, and Webhooks (event: payment.captured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dodo Payments — Developer → API Keys, and Webhooks (event: payment.succeeded)
# Use https://test.dodopayments.com while testing, https://live.dodopayments.com in production
DODO_API_URL=https://test.dodopayments.com
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# A "pay what you want" product created in the Dodo dashboard, priced in USD
DODO_PRODUCT_ID=

GST_RATE=0.18
